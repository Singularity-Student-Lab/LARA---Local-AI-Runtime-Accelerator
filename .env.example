# LARA environment configuration.
# Copy to .env and fill in real values. .env is git-ignored; this file never holds a secret.
# Every key here is documented in Docs/LARA_7_Session_Implementation_Reference.md section 23.

# ---------------------------------------------------------------------------
# Session 1 - environment selector and host
# ---------------------------------------------------------------------------
# dev = this workstation, Ollama backend, no GPU reservation for lara-inference
# prod = the beast (Windows 11 + WSL2 + RTX 5060 Ti), vLLM backend
LARA_ENV=dev

# info in normal operation; never debug by default in prod (may log more than intended)
LARA_LOG_LEVEL=info

# Host path for model weights, mounted read-only at /models inside lara-inference.
# Only meaningful when LARA_ENV=prod. Not used by the dev Ollama path (Ollama manages its
# own model storage on the host).
LARA_MODEL_DIR=./model-cache

# Which compose profiles start. dev = gateway+database(+telemetry). prod adds lara-inference.
# tunnel adds lara-cloudflared. Combine as needed, e.g. "prod,tunnel".
COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
# Session 2 - inference backends
# ---------------------------------------------------------------------------
# Pinned vLLM image tag. Verify against the beast's driver/CUDA once available
# (see docs/operations/host-setup-beast.md). Set to ollama-dev:latest for dev-only.
LARA_INFERENCE_IMAGE=ollama-dev:latest

# Which file under inference/configs/ the active backend starts from.
LARA_ACTIVE_MODEL_CONFIG=ollama-dev.yaml

LARA_VLLM_BASE_URL=http://lara-inference:8000

# Verified for this dev machine (native Linux Docker, not WSL2): the gateway container
# reaches the host's Ollama via extra_hosts host.docker.internal:host-gateway.
# See docs/operations/dev-backend.md for the verification record.
LARA_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only needed if a candidate model requires authenticated download. Never committed.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Session 3 - database, auth, proxy
# ---------------------------------------------------------------------------
# Dev-only PostgreSQL credentials. Rotate for production.
POSTGRES_USER=lara
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY
POSTGRES_DB=lara
DATABASE_URL=postgresql+asyncpg://lara:CHANGE_ME_DEV_ONLY@lara-database:5432/lara

# Server-side pepper for API key HMAC verification. Rotating this invalidates every key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LARA_API_KEY_PEPPER=CHANGE_ME_DEV_PEPPER

# Optional. Unused in V1 - admin auth is API-key + role, not a session/password portal.
LARA_JWT_SECRET=

LARA_DEFAULT_BACKEND=ollama-dev
LARA_DEFAULT_MODEL_ALIAS=campus-coder

LARA_MAX_REQUEST_BYTES=2097152

LARA_CONNECT_TIMEOUT_S=5
# Dev defaults generous enough for 8B model on 6GB GPU; tune for production workload.
LARA_TTFT_TIMEOUT_S=60
LARA_REQUEST_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# Session 4 - scheduler and queue
# ---------------------------------------------------------------------------
# PRD REQUIREMENT: global GPU concurrency ceiling. Do not raise without a measured reason.
LARA_MAX_ACTIVE_JOBS=3
LARA_PER_USER_MAX_ACTIVE=1
# NOT YET MEASURED
LARA_QUEUE_MAX_DEPTH=50
LARA_QUEUE_TIMEOUT_S=120
LARA_SSE_KEEPALIVE_S=5

# ---------------------------------------------------------------------------
# Session 5 - operating modes and GPU pressure
# ---------------------------------------------------------------------------
LARA_MODE_DEFAULT=SERVING
LARA_GPU_SAMPLE_INTERVAL_S=5
LARA_PRESSURE_WINDOW_SAMPLES=12
LARA_PRESSURE_HYSTERESIS_SAMPLES=3

# NOT YET MEASURED - provisional thresholds. Real values come from Session 7 benchmarking
# against a real Unity/Unreal workload on the beast (PRD 10.3, blueprint section 5.3.3).
# These provisional values are sized for the DEV GPU (RTX 3050, 6GB) and are NOT valid
# for the production RTX 5060 Ti 16GB - recompute before relying on them there.
LARA_PRESSURE_VRAM_MODERATE=60
LARA_PRESSURE_VRAM_HIGH=80
LARA_PRESSURE_VRAM_CRITICAL=92
LARA_PRESSURE_UTIL_MODERATE=70
LARA_PRESSURE_UTIL_HIGH=85
LARA_PRESSURE_TEMP_CRITICAL=85

LARA_DRAIN_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Session 6 - tunnel and hardening
# ---------------------------------------------------------------------------
# Secret. Never committed. Empty by default - the tunnel profile is not started until
# a real Cloudflare tunnel exists (docs/operations/tunnel.md).
CLOUDFLARE_TUNNEL_TOKEN=

LARA_PUBLIC_BASE_URL=

# NOT YET MEASURED - tune against real agent retry behaviour once observed.
# Dev/test needs enough headroom for scheduler load tests, which rapidly create users,
# poll queue state, and cancel jobs using a single isolated admin key.
LARA_RATE_LIMIT_REQUESTS=300
LARA_RATE_LIMIT_WINDOW_S=60

LARA_AUTH_FAIL_THRESHOLD=10
LARA_AUTH_FAIL_WINDOW_S=60
LARA_AUTH_FAIL_BLOCK_S=300

# Only trust forwarded-for headers when all public traffic arrives through the tunnel.
LARA_TRUSTED_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Session 7 - telemetry, retention, analytics
# ---------------------------------------------------------------------------
LARA_RETENTION_JOBS_DAYS=90
LARA_RETENTION_GPU_RAW_DAYS=14
LARA_RETENTION_AUDIT_DAYS=365

# PRD REQUIREMENT (12.1): approximately 20GB total operational storage budget.
LARA_LOG_MAX_GB=20

LARA_LEADERBOARD_ENABLED=true
# JSON weights, tunable without a deployment. See gateway/app/analytics/leaderboard.py.
LARA_LEADERBOARD_WEIGHTS={"successful_requests": 1.0, "active_days": 5.0, "agent_sessions": 3.0, "tokens": 0.001}

# PRD REQUIREMENT (12.4): full prompt/response logging stays off by default. Enabling it
# is a deliberate, time-boxed, documented exception - see docs/security/auth.md.
LARA_TRANSCRIPT_LOGGING=false